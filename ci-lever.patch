@@ -0,0 +1,174 @@
+// the Metal host bank binding (proc address "ggml_backend_metal_alias_host", used by the MoE copy callback on unified memory): a
+// Metal tensor that holds zeros is bound to host memory at page and non-page offsets, a graph that reads it (the tensor and a view
+// of it) must return the host bytes, the next graph (nothing bound) must read the zeros again, and the tensor itself is never
+// written. The default arm sets GGML_METAL_HOST_BANK_BIND=1 (the bind is off by default);
+// with --off (run under GGML_METAL_HOST_BANK_BIND=0 or unset) the bind must be refused and every graph reads the zeros.
+// SKIP without a Metal device; exit 1 on any difference.
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+#if defined(__APPLE__)
+#include <sys/mman.h>
+#include <unistd.h>
+
+using alias_host_t = bool (*)(ggml_backend_t, const ggml_tensor *, const void *, size_t);
+
+// out = cpy(bank) and view_out = cpy(view of bank at view_off elements), both computed on be; returns the two outputs
+static void run_graph(ggml_backend_t be, ggml_tensor * bank, int64_t n, int64_t view_off, int64_t view_n,
+        std::vector<float> & out, std::vector<float> & out_view) {
+    ggml_init_params ip = { 16*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * dst  = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n);
+    ggml_tensor * dstv = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, view_n);
+    ggml_tensor * v    = ggml_view_1d(ctx, bank, view_n, view_off*sizeof(float));
+    ggml_tensor * c0   = ggml_cpy(ctx, bank, dst);
+    ggml_tensor * c1   = ggml_cpy(ctx, v, dstv);
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, c0);
+    ggml_build_forward_expand(gf, c1);
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, be);
+    if (ggml_backend_graph_compute(be, gf) != GGML_STATUS_SUCCESS) {
+        fprintf(stderr, "graph compute failed\n");
+        exit(1);
+    }
+    ggml_backend_synchronize(be);
+    out.resize(n);
+    out_view.resize(view_n);
+    ggml_backend_tensor_get(dst,  out.data(),      0, n*sizeof(float));
+    ggml_backend_tensor_get(dstv, out_view.data(), 0, view_n*sizeof(float));
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+}
+
+static int run(int argc, char ** argv) {
+    const bool off = argc > 1 && strcmp(argv[1], "--off") == 0;
+
+    // the bind is off by default: the default arm enables it, --off keeps whatever the environment says (=0 or unset)
+    if (!off) {
+        setenv("GGML_METAL_HOST_BANK_BIND", "1", 1);
+    }
+
+    ggml_backend_load_all();
+
+    int n_dev   = 0;
+    int n_cases = 0;
+    int n_bind  = 0;
+    int n_bad   = 0;
+    for (size_t d = 0; d < ggml_backend_dev_count(); ++d) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(d);
+        if (strncmp(ggml_backend_dev_name(dev), "MTL", 3) != 0) {
+            continue;
+        }
+        ggml_backend_reg_t reg = ggml_backend_dev_backend_reg(dev);
+        auto fn = (alias_host_t) ggml_backend_reg_get_proc_address(reg, "ggml_backend_metal_alias_host");
+        if (fn == nullptr) {
+            printf("%s: no ggml_backend_metal_alias_host: FAIL\n", ggml_backend_dev_name(dev));
+            n_bad++;
+            continue;
+        }
+        ggml_backend_t be = ggml_backend_dev_init(dev, nullptr);
+        if (be == nullptr) {
+            continue;
+        }
+        n_dev++;
+
+        const size_t page    = (size_t) sysconf(_SC_PAGESIZE);
+        const size_t map_len = (size_t) 40 << 20;
+        uint8_t * host = (uint8_t *) mmap(nullptr, map_len, PROT_READ | PROT_WRITE, MAP_ANON | MAP_PRIVATE, -1, 0);
+        if (host == MAP_FAILED) {
+            fprintf(stderr, "mmap failed\n");
+            return 1;
+        }
+        std::mt19937 rng(7);
+
+        for (int64_t n : { (int64_t) 1000, (int64_t) 65536, (int64_t) (8 << 20) / 4 + 3 }) {
+            for (size_t src_off : { (size_t) 0, (size_t) 4, (size_t) 100, page + 4 }) {
+                ggml_init_params ip = { 4*ggml_tensor_overhead(), nullptr, true };
+                ggml_context * ctx = ggml_init(ip);
+                ggml_tensor * bank = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, n);
+                ggml_set_name(bank, "bank");
+                ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, be);
+                ggml_backend_buffer_clear(buf, 0);
+
+                float * src = (float *) (host + src_off);
+                for (int64_t i = 0; i < n; ++i) {
+                    src[i] = (float) (int32_t) (rng() % 2000001) - 1000000.0f;
+                }
+                const int64_t view_off = n/3;
+                const int64_t view_n   = n - view_off;
+
+                const bool bound = fn(be, bank, src, n*sizeof(float));
+                n_bind += bound;
+                std::vector<float> o0, o0v, o1, o1v;
+                run_graph(be, bank, n, view_off, view_n, o0, o0v);
+                // nothing bound for the next graph
+                run_graph(be, bank, n, view_off, view_n, o1, o1v);
+
+                int64_t bad = 0;
+                if (off && bound) {
+                    bad++;
+                    printf("  bound under GGML_METAL_HOST_BANK_BIND=0\n");
+                }
+                for (int64_t i = 0; i < n; ++i) {
+                    const float want0 = bound ? src[i] : 0.0f;
+                    bad += memcmp(&o0[i], &want0, sizeof(float)) != 0;
+                    bad += o1[i] != 0.0f;
+                }
+                for (int64_t i = 0; i < view_n; ++i) {
+                    const float want0 = bound ? src[view_off + i] : 0.0f;
+                    bad += memcmp(&o0v[i], &want0, sizeof(float)) != 0;
+                    bad += o1v[i] != 0.0f;
+                }
+                // the bound tensor itself still holds the zeros
+                std::vector<float> own(n);
+                ggml_backend_tensor_get(bank, own.data(), 0, n*sizeof(float));
+                for (int64_t i = 0; i < n; ++i) {
+                    bad += own[i] != 0.0f;
+                }
+                n_cases++;
+                printf("  n %8lld src_off %5zu: %s, %lld differ%s\n", (long long) n, src_off, bound ? "bound" : "not bound", (long long) bad, "");
+                if (bad != 0) {
+                    n_bad++;
+                }
+                ggml_backend_buffer_free(buf);
+                ggml_free(ctx);
+            }
+        }
+        munmap(host, map_len);
+        ggml_backend_free(be);
+    }
+
+    if (n_dev == 0) {
+        printf("SKIP: no Metal device\n");
+        return 0;
+    }
+    printf("%s: %d cases, %d bound, %d with differences%s\n", n_bad == 0 && (off ? n_bind == 0 : true) ? "OK" : "FAIL", n_cases, n_bind, n_bad,
+            off ? " (GGML_METAL_HOST_BANK_BIND=0)" : "");
+    // with the bind on, a unified-memory device must bind every case (the hosted runners are unified memory)
+    if (!off && n_bind == 0) {
+        printf("FAIL: nothing was bound\n");
+        return 1;
+    }
+    return n_bad == 0 ? 0 : 1;
+}
+#endif
+
+int main(int argc, char ** argv) {
+#if defined(__APPLE__)
+    return run(argc, argv);
+#else
+    (void) argc;
+    (void) argv;
+    printf("SKIP: no Metal device\n");
+    return 0;
+#endif
+}
diff --git a/tests/test-metal-mmid-map.cpp b/tests/test-metal-mmid-map.cpp
new file mode 100644
index 00000000000..1dde57d751b
--- /dev/null
+++ b/tests/test-metal-mmid-map.cpp
@@ -0,0 +1,282 @@
+// host-side models of the Metal MUL_MAT_ID and selection-mask changes, run on any host (no Metal device needed):
+//  1. the CPU reference of kernel_mul_mm_id_map0 (ggml-metal-mmid.h) against a direct count: every (token, slot) entry of
+//     an in-range expert lands in exactly one tile of its expert, tiles hold at most 32 rows, the tile count stays within
+//     the bound the host sizes the dispatch and the scratch by (ggml_metal_mmid_max_tiles), the map is a function of the ids
+//  2. the map-share key and range test of ggml_metal_op_mul_mat_id
+//  3. the simdgroup block assignment of kernel_mul_mm_id (non-tensor path) with GGML_METAL_MMID_SGSPLIT / _BSKIP on and
+//     off: every live output block is computed by exactly one simdgroup, as one accumulator over the full K chain, and
+//     every block written back is computed; prints the multiply-accumulates per K step (busiest simdgroup / total)
+//  4. the compute buffer of the selection mask: the ggml_sel_mask node against the chain it replaces (graph allocator
+//     sizes on the CPU buffer type)
+
+#include "../ggml/src/ggml-metal/ggml-metal-mmid.h"
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "ggml-sel-mask.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <set>
+#include <vector>
+
+static int n_fail = 0;
+
+#define CHECK(cond, ...) do { if (!(cond)) { n_fail++; fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__); fprintf(stderr, __VA_ARGS__); fprintf(stderr, "\n"); } } while (0)
+
+static void test_map0(std::mt19937 & rng) {
+    int n_cases = 0;
+    for (int64_t ne02 : { 1, 4, 28, 128, 512, 1024 }) {
+        for (int64_t ne20 : { 1, 2, 4, 8, 10 }) {
+            for (int64_t ne21 : { 1, 9, 16, 32, 33, 64, 300, 512 }) {
+                for (int mode = 0; mode < 4; ++mode) {
+                    // 0: distinct ids per token, 1: repeated ids (mostly expert 0), 2: all on one expert, 3: some ids out of range
+                    std::vector<int32_t> ids(ne20*ne21);
+                    for (int64_t t = 0; t < ne21; ++t) {
+                        std::vector<int32_t> perm(ne02);
+                        for (int64_t e = 0; e < ne02; ++e) {
+                            perm[e] = (int32_t) e;
+                        }
+                        std::shuffle(perm.begin(), perm.end(), rng);
+                        for (int64_t s = 0; s < ne20; ++s) {
+                            int32_t v = 0;
+                            switch (mode) {
+                                case 0: v = perm[s % ne02]; break;
+                                case 1: v = rng() % 4 == 0 ? (int32_t) (rng() % ne02) : 0; break;
+                                case 2: v = (int32_t) (ne02 - 1); break;
+                                case 3: v = rng() % 5 == 0 ? (int32_t) (ne02 + rng() % 3) : (int32_t) (rng() % ne02); break;
+                            }
+                            ids[t*ne20 + s] = v;
+                        }
+                    }
+
+                    std::vector<uint32_t> tpe;
+                    std::vector<int32_t>  hids;
+                    ggml_metal_mmid_map0_ref(ids.data(), ne20, ne21, ne02, tpe, hids);
+
+                    const int64_t n_tiles = tpe[0];
+                    const int64_t bound   = ggml_metal_mmid_max_tiles(ne02, ne20, ne21);
+                    CHECK(n_tiles <= bound, "tiles %lld > bound %lld (ne02 %lld ne20 %lld ne21 %lld mode %d)",
+                        (long long) n_tiles, (long long) bound, (long long) ne02, (long long) ne20, (long long) ne21, mode);
+                    // scratch sizes of the host (extra_tpe / extra_ids)
+                    CHECK((int64_t) tpe.size() <= 1 + 3*bound, "tpe size");
+                    CHECK((int64_t) hids.size() <= ne20*ne21 + ne02, "hids size %zu", hids.size());
+
+                    std::vector<int> seen(ne20*ne21, 0);
+                    int64_t prev_e = -1;
+                    for (int64_t i = 0; i < n_tiles; ++i) {
+                        const uint32_t e = tpe[1 + 3*i], first = tpe[1 + 3*i + 1], rows = tpe[1 + 3*i + 2];
+                        CHECK(rows >= 1 && rows <= GGML_METAL_MMID_NTILE, "rows %u", rows);
+                        CHECK((int64_t) e >= prev_e, "experts out of order");
+                        prev_e = e;
+                        for (uint32_t r = 0; r < rows; ++r) {
+                            const int32_t ent = hids[first + r];
+                            CHECK(ent >= 0 && ent < ne20*ne21, "entry %d", ent);
+                            if (ent >= 0 && ent < ne20*ne21) {
+                                CHECK(ids[ent] == (int32_t) e, "entry %d routes to %d, tile expert %u", ent, ids[ent], e);
+                                seen[ent]++;
+                            }
+                        }
+                    }
+                    for (int64_t k = 0; k < ne20*ne21; ++k) {
+                        const bool in_range = ids[k] >= 0 && ids[k] < ne02;
+                        CHECK(seen[k] == (in_range ? 1 : 0), "entry %lld seen %d times (id %d)", (long long) k, seen[k], ids[k]);
+                    }
+
+                    // the map is a function of the ids: a second build is identical
+                    std::vector<uint32_t> tpe2;
+                    std::vector<int32_t>  hids2;
+                    ggml_metal_mmid_map0_ref(ids.data(), ne20, ne21, ne02, tpe2, hids2);
+                    CHECK(tpe == tpe2 && hids == hids2, "map not deterministic");
+
+                    n_cases++;
+                }
+            }
+        }
+    }
+    printf("map0 reference: %d cases\n", n_cases);
+}
+
+static void test_share_key() {
+    int buf_a = 0, buf_b = 0;
+    ggml_metal_mmid_map_key k0;
+    k0.ids_buf = &buf_a; k0.ids_data = (const void *) 0x1000; k0.ne20 = 8; k0.ne21 = 512; k0.nb20 = 4; k0.nb21 = 32; k0.ne02 = 128;
+    ggml_metal_mmid_map_key k1 = k0;
+    CHECK(k0 == k1, "equal keys");
+    k1.ids_buf = &buf_b;    CHECK(!(k0 == k1), "buffer"); k1 = k0;
+    k1.ids_data = (const void *) 0x2000; CHECK(!(k0 == k1), "address"); k1 = k0;
+    k1.ne20 = 4;  CHECK(!(k0 == k1), "ne20"); k1 = k0;
+    k1.ne21 = 511; CHECK(!(k0 == k1), "ne21"); k1 = k0;
+    k1.nb21 = 64; CHECK(!(k0 == k1), "nb21"); k1 = k0;
+    k1.ne02 = 64; CHECK(!(k0 == k1), "ne02"); k1 = k0;
+
+    CHECK( ggml_metal_mmid_ranges_overlap(&buf_a, 0, 10, &buf_a, 9, 20), "overlap");
+    CHECK(!ggml_metal_mmid_ranges_overlap(&buf_a, 0, 10, &buf_a, 10, 20), "touching");
+    CHECK(!ggml_metal_mmid_ranges_overlap(&buf_a, 0, 10, &buf_b, 0, 10), "other buffer");
+    CHECK( ggml_metal_mmid_ranges_overlap(&buf_a, 5, 6, &buf_a, 0, 100), "inside");
+    printf("map share key / ranges: ok\n");
+}
+
+// kernel_mul_mm_id, non-tensor path: the (A block g, B block b) output blocks each simdgroup accumulates, and the ones it
+// writes to threadgroup memory. A block g covers A rows 8g .. 8g+7 (0..7), B block b token rows 8b .. 8b+7 (0..3).
+struct mmid_block { int sg, g, b; };
+
+static void mmid_blocks(int nr1, bool sgsplit, bool bskip, std::vector<mmid_block> & mma, std::vector<mmid_block> & stored) {
+    const int NR1H = 16;
+    const bool has_hi = nr1 > NR1H;
+    mma.clear();
+    stored.clear();
+    for (int sg = 0; sg < 4; ++sg) {
+        const bool split4    = sgsplit && !has_hi;
+        const bool sg_active = split4 || has_hi || sg < 2;
+        const int  r1b       = split4 ? 0 : NR1H*(sg >> 1);
+        const bool b1_live   = !bskip || r1b + 8 < nr1;
+        if (split4) {
+            for (int i = 0; i < 2; ++i) {
+                mma.push_back({ sg, 2*sg + i, 0 });
+                if (b1_live) {
+                    mma.push_back({ sg, 2*sg + i, 1 });
+                }
+            }
+            for (int i = 0; i < (b1_live ? 4 : 2); ++i) {
+                stored.push_back({ sg, 2*sg + (i % 2), i / 2 });
+            }
+        } else if (sg_active) {
+            for (int i = 0; i < 4; ++i) {
+                mma.push_back({ sg, 4*(sg % 2) + i, 2*(sg / 2) + 0 });
+            }
+            if (b1_live) {
+                for (int i = 4; i < 8; ++i) {
+                    mma.push_back({ sg, 4*(sg % 2) + (i % 4), 2*(sg / 2) + 1 });
+                }
+            }
+            for (int i = 0; i < (b1_live ? 8 : 4); ++i) {
+                stored.push_back({ sg, 4*(sg % 2) + (i % 4), 2*(sg / 2) + i / 4 });
+            }
+        }
+    }
+}
+
+static void test_mmid_blocks() {
+    printf("kernel_mul_mm_id multiply-accumulates per K step of 8 (busiest simdgroup / all), by valid rows of the tile:\n");
+    printf("  nr1 | before  | bskip   | sgsplit | both\n");
+    for (int nr1 = 1; nr1 <= 32; ++nr1) {
+        char line[256];
+        int  off = snprintf(line, sizeof(line), "  %3d", nr1);
+        for (int f = 0; f < 4; ++f) {
+            const bool sgsplit = f & 2, bskip = f & 1;
+            std::vector<mmid_block> mma, stored;
+            mmid_blocks(nr1, sgsplit, bskip, mma, stored);
+
+            // every live output block (B rows < nr1) once, as one accumulator
+            for (int b = 0; b < 4; ++b) {
+                for (int g = 0; g < 8; ++g) {
+                    int n = 0;
+                    for (const auto & m : mma) {
+                        n += m.g == g && m.b == b;
+                    }
+                    const bool live = 8*b < nr1;
+                    if (live) {
+                        CHECK(n == 1, "nr1 %d flags %d: live block (g %d, b %d) computed %d times", nr1, f, g, b, n);
+                    } else {
+                        CHECK(n <= 1, "nr1 %d flags %d: dead block (g %d, b %d) computed %d times", nr1, f, g, b, n);
+                    }
+                    int ns = 0;
+                    for (const auto & s : stored) {
+                        ns += s.g == g && s.b == b;
+                    }
+                    if (live) {
+                        CHECK(ns == 1, "nr1 %d flags %d: live block (g %d, b %d) stored %d times", nr1, f, g, b, ns);
+                    }
+                }
+            }
+            // a stored block is computed by the simdgroup that stores it
+            for (const auto & s : stored) {
+                bool found = false;
+                for (const auto & m : mma) {
+                    found |= m.sg == s.sg && m.g == s.g && m.b == s.b;
+                }
+                CHECK(found, "nr1 %d flags %d: sg %d stores (g %d, b %d) it did not compute", nr1, f, s.sg, s.g, s.b);
+            }
+            int per_sg[4] = { 0, 0, 0, 0 };
+            for (const auto & m : mma) {
+                per_sg[m.sg]++;
+            }
+            const int busiest = *std::max_element(per_sg, per_sg + 4);
+            off += snprintf(line + off, sizeof(line) - off, " | %2d / %2d", busiest, (int) mma.size());
+        }
+        if (nr1 <= 17 || nr1 == 24 || nr1 == 25 || nr1 == 32) {
+            printf("%s\n", line);
+        }
+    }
+}
+
+// compute buffer of the selection mask node vs the chain (as tests/test-backend-ops.cpp test_sel_mask / llama-graph)
+static size_t sel_mask_buffer(int64_t kv, int64_t nb, int64_t n_sel, bool chain) {
+    ggml_init_params ip = { 64*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+    ggml_tensor * kq  = ggml_new_tensor_4d(ctx, GGML_TYPE_F16, kv, nb, 1, 1);
+    ggml_tensor * idx = ggml_new_tensor_3d(ctx, GGML_TYPE_I32, n_sel, nb, 1);
+    ggml_set_input(kq);
+    ggml_set_input(idx);
+    ggml_tensor * out;
+    if (!chain) {
+        out = ggml_sel_mask(ctx, idx, kq);
+    } else {
+        ggml_tensor * mask_all = ggml_fill(ctx, ggml_new_tensor_4d(ctx, GGML_TYPE_F16, kv + n_sel, 1, 1, 1), -INFINITY);
+        mask_all = ggml_repeat_4d(ctx, mask_all, kv + n_sel, nb, 1, 1);
+        mask_all = ggml_reshape_3d(ctx, mask_all, 1, kv + n_sel, nb);
+        ggml_tensor * zeros = ggml_fill(ctx, ggml_new_tensor_4d(ctx, GGML_TYPE_F16, n_sel, 1, 1, 1), 0.0f);
+        zeros = ggml_repeat_4d(ctx, zeros, n_sel, nb, 1, 1);
+        zeros = ggml_reshape_3d(ctx, zeros, 1, n_sel, nb);
+        ggml_tensor * sel = ggml_set_rows(ctx, mask_all, zeros, idx);
+        const size_t row = sel->nb[2];
+        sel = ggml_view_4d(ctx, sel, kv, nb, 1, 1, row, row*nb, row*nb, 0);
+        out = ggml_add(ctx, sel, kq);
+    }
+    ggml_set_output(out);
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, out);
+    ggml_gallocr_t ga = ggml_gallocr_new(ggml_backend_cpu_buffer_type());
+    size_t size = 0;
+    if (ggml_gallocr_reserve(ga, gf)) {
+        size = ggml_gallocr_get_buffer_size(ga, 0);
+    }
+    ggml_gallocr_free(ga);
+    ggml_free(ctx);
+    return size;
+}
+
+static void test_sel_mask_scratch() {
+    printf("selection mask compute buffer (n_sel 2051), node vs chain:\n");
+    for (int64_t kv : { 8192, 65536, 262144 }) {
+        for (int64_t nb : { 512, 2048 }) {
+            const size_t node  = sel_mask_buffer(kv, nb, 2051, false);
+            const size_t chain = sel_mask_buffer(kv, nb, 2051, true);
+            CHECK(node > 0 && chain > 0 && node < chain, "kv %lld nb %lld: node %zu chain %zu", (long long) kv, (long long) nb, node, chain);
+            printf("  kv %6lld ub %4lld: node %8.1f MiB, chain %8.1f MiB, saved %8.1f MiB\n", (long long) kv, (long long) nb,
+                node/1048576.0, chain/1048576.0, (double) (chain - node)/1048576.0);
+        }
+    }
+}
+
+int main() {
+    std::mt19937 rng(42);
+
+    test_map0(rng);
+    test_share_key();
+    test_mmid_blocks();
+    test_sel_mask_scratch();
+
+    if (n_fail > 0) {
+        printf("FAILED: %d checks\n", n_fail);
+        return 1;
+    }
+    printf("OK\n");
+    return 0;
+}
diff --git a/tests/test-metal-mmid-pair-exact.cpp b/tests/test-metal-mmid-pair-exact.cpp
new file mode 100644
index 00000000000..a06b7bf64cc
--- /dev/null
+++ b/tests/test-metal-mmid-pair-exact.cpp
@@ -0,0 +1,332 @@
+// bit identity of the paired-route mat-vec MUL_MAT_ID on Metal (GGML_METAL_MMID_PAIR=1) against the single-route kernel
+// (GGML_METAL_MMID_PAIR=0): verify windows of 2 to 16 tokens whose routes collide on a few experts (and repeated experts within
+// a token), Q8_0 / Q4_K / Q5_K / Q6_K experts, src1 per route and broadcast. The two arms run in child processes of this binary
+// (the switch is read once per process); the parent compares the output bytes of every case. The CPU backend is a sanity
+// reference (NMSE, not bytes). A negative control changes one src1 value: its output must differ. Prints the number of cases,
+// the paired / single entries of each case (from the reference list builder, ggml-metal-mmid-pair.h) and the differing ones;
+// exit 1 on any difference. SKIP (exit 0) without a Metal device or when MTL0 does not support the op.
+
+#include "ggml.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+
+#include "../ggml/src/ggml-metal/ggml-metal-mmid-pair.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <string>
+#include <vector>
+
+#include <unistd.h>
+
+struct pair_case {
+    ggml_type type;
+    int64_t   K, M, n_as, n_used, T;
+    bool      bcast;     // src1 [K, 1, T] instead of [K, n_used, T]
+    bool      dup;       // repeated experts within a token
+    bool      control;   // case 0 with one src1 value changed
+};
+
+static std::vector<pair_case> make_cases() {
+    std::vector<pair_case> cases;
+    const ggml_type types[] = { GGML_TYPE_Q8_0, GGML_TYPE_Q4_K, GGML_TYPE_Q5_K, GGML_TYPE_Q6_K };
+    struct cfg { int64_t n_used, n_as; };
+    const cfg cfgs[] = { { 1, 4 }, { 2, 8 }, { 8, 128 }, { 10, 512 } };
+    int i = 0;
+    for (ggml_type t : types) {
+        for (const cfg & c : cfgs) {
+            for (int64_t T : { 2, 3, 5, 8, 16 }) {
+                const int64_t M = (i % 2) ? 70 : 96;
+                cases.push_back({ t, 512, M, c.n_as, c.n_used, T, c.n_used == 1 && T % 2 == 1, false, false });
+                i++;
+            }
+        }
+        cases.push_back({ t, 768, 64, 16, 4, 7, false, true, false });
+    }
+    pair_case ctl = cases[0];
+    ctl.control = true;
+    cases.push_back(ctl);
+    return cases;
+}
+
+// ids of a window that collides: the experts of every token come from a pool a little larger than n_used
+static uint32_t case_seed(const pair_case & c) {
+    return 1234 + (uint32_t) (c.K + 31*c.M + 131*c.n_as + 977*c.n_used + 7919*c.T + 104729*(int) c.type + 3*c.dup + 5*c.bcast);
+}
+
+static std::vector<int32_t> make_ids(const pair_case & c) {
+    std::mt19937 rng(case_seed(c) ^ 0x1D5u);
+    std::vector<int32_t> ids(c.n_used*c.T);
+    const int64_t pool = std::min<int64_t>(c.n_as, c.n_used + 2);
+    std::vector<int32_t> base(pool);
+    for (int64_t j = 0; j < pool; ++j) {
+        base[j] = (int32_t) ((j*7919 + 13) % c.n_as);
+    }
+    for (int64_t t = 0; t < c.T; ++t) {
+        std::vector<int32_t> p = base;
+        std::shuffle(p.begin(), p.end(), rng);
+        for (int64_t s = 0; s < c.n_used; ++s) {
+            ids[t*c.n_used + s] = c.dup && s > 0 && rng() % 3 == 0 ? ids[t*c.n_used + s - 1] : p[s];
+        }
+    }
+    return ids;
+}
+
+// output of one case on one backend; empty with *supported = false when the backend does not run the op
+static std::vector<float> run_case(ggml_backend_t be, const pair_case & c, bool * supported) {
+    std::mt19937 rng(case_seed(c));
+
+    ggml_init_params ip = { 16*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(ip);
+
+    const int64_t n_b = c.bcast ? 1 : c.n_used;
+
+    ggml_tensor * as  = ggml_new_tensor_3d(ctx, c.type, c.K, c.M, c.n_as);
+    ggml_tensor * b   = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, c.K, n_b, c.T);
+    ggml_tensor * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, c.n_used, c.T);
+    ggml_tensor * out = ggml_mul_mat_id(ctx, as, b, ids);
+
+    *supported = ggml_backend_supports_op(be, out);
+    if (!*supported) {
+        ggml_free(ctx);
+        return {};
+    }
+
+    ggml_cgraph * gf = ggml_new_graph(ctx);
+    ggml_build_forward_expand(gf, out);
+
+    ggml_backend_buffer_t buf = ggml_backend_alloc_ctx_tensors(ctx, be);
+
+    std::uniform_real_distribution<float> ud(-1.0f, 1.0f);
+
+    std::vector<float> wf(c.K*c.M*c.n_as);
+    for (float & v : wf) {
+        v = ud(rng);
+    }
+    std::vector<uint8_t> wq(ggml_nbytes(as));
+    ggml_quantize_chunk(c.type, wf.data(), wq.data(), 0, c.M*c.n_as, c.K, nullptr);
+    ggml_backend_tensor_set(as, wq.data(), 0, wq.size());
+
+    std::vector<float> bf(c.K*n_b*c.T);
+    for (float & v : bf) {
+        v = ud(rng);
+    }
+    if (c.control) {
+        bf[c.K + 3] += 0.5f;
+    }
+    ggml_backend_tensor_set(b, bf.data(), 0, bf.size()*sizeof(float));
+
+    std::vector<int32_t> iv = make_ids(c);
+    ggml_backend_tensor_set(ids, iv.data(), 0, iv.size()*sizeof(int32_t));
+
+    std::vector<float> res;
+    if (ggml_backend_graph_compute(be, gf) == GGML_STATUS_SUCCESS) {
+        res.resize(ggml_nelements(out));
+        ggml_backend_tensor_get(out, res.data(), 0, res.size()*sizeof(float));
+    }
+
+    ggml_backend_buffer_free(buf);
+    ggml_free(ctx);
+
+    return res;
+}
+
+static ggml_backend_t init_metal() {
+    for (size_t d = 0; d < ggml_backend_dev_count(); ++d) {
+        ggml_backend_dev_t dev = ggml_backend_dev_get(d);
+        const enum ggml_backend_dev_type type = ggml_backend_dev_type(dev);
+        if ((type == GGML_BACKEND_DEVICE_TYPE_GPU || type == GGML_BACKEND_DEVICE_TYPE_IGPU) &&
+                strncmp(ggml_backend_dev_name(dev), "MTL", 3) == 0) {
+            return ggml_backend_dev_init(dev, nullptr);
+        }
+    }
+    return nullptr;
+}
+
+// child: every case on MTL0, written as (int32 supported, int64 n, n floats) records
+static int child(const char * path) {
+    ggml_backend_t be = init_metal();
+    if (be == nullptr) {
+        return 2;
+    }
+    FILE * f = fopen(path, "wb");
+    if (f == nullptr) {
+        return 3;
+    }
+    for (const pair_case & c : make_cases()) {
+        bool sup = false;
+        std::vector<float> r = run_case(be, c, &sup);
+        const int32_t s = sup && !r.empty();
+        const int64_t n = (int64_t) r.size();
+        fwrite(&s, sizeof(s), 1, f);
+        fwrite(&n, sizeof(n), 1, f);
+        if (n > 0) {
+            fwrite(r.data(), sizeof(float), n, f);
+        }
+    }
+    fclose(f);
+    ggml_backend_free(be);
+    return 0;
+}
+
+struct rec {
+    int32_t supported;
+    std::vector<float> v;
+};
+
+static bool read_recs(const std::string & path, size_t n_cases, std::vector<rec> & out) {
+    FILE * f = fopen(path.c_str(), "rb");
+    if (f == nullptr) {
+        return false;
+    }
+    out.assign(n_cases, {});
+    for (size_t i = 0; i < n_cases; ++i) {
+        int64_t n = 0;
+        if (fread(&out[i].supported, sizeof(int32_t), 1, f) != 1 || fread(&n, sizeof(n), 1, f) != 1) {
+            fclose(f);
+            return false;
+        }
+        out[i].v.resize(n);
+        if (n > 0 && fread(out[i].v.data(), sizeof(float), n, f) != (size_t) n) {
+            fclose(f);
+            return false;
+        }
+    }
+    fclose(f);
+    return true;
+}
+
+int main(int argc, char ** argv) {
+    ggml_backend_load_all();
+
+    if (argc == 3 && strcmp(argv[1], "--child") == 0) {
+        return child(argv[2]);
+    }
+
+    ggml_backend_t mtl = init_metal();
+    if (mtl == nullptr) {
+        printf("test-metal-mmid-pair-exact: SKIP (no Metal device)\n");
+        return 0;
+    }
+    ggml_backend_free(mtl);
+
+    const std::vector<pair_case> cases = make_cases();
+
+    const char * tmp = getenv("TMPDIR") ? getenv("TMPDIR") : "/tmp";
+    std::string out_path[2];
+    int n_log[2] = { 0, 0 };
+    for (int arm = 0; arm < 2; ++arm) {
+        const std::string stem = std::string(tmp) + "/test-metal-mmid-pair-" + std::to_string((long) getpid()) + "-" + std::to_string(arm);
+        out_path[arm] = stem + ".bin";
+        const std::string log_path = stem + ".log";
+        // GGML_METAL_MMID_PAIR_DEBUG=1 in both arms: one log line per op that takes the paired path (0 in the off arm)
+        const std::string cmd = std::string("GGML_METAL_MMID_PAIR=") + std::to_string(arm) + " GGML_METAL_MMID_PAIR_DEBUG=1 '" + argv[0] +
+            "' --child '" + out_path[arm] + "' 2> '" + log_path + "'";
+        const int rc = system(cmd.c_str());
+        FILE * lf = fopen(log_path.c_str(), "r");
+        if (lf != nullptr) {
+            char line[1024];
+            while (fgets(line, sizeof(line), lf)) {
+                n_log[arm] += strstr(line, "mmid pair:") != nullptr;
+            }
+            fclose(lf);
+            unlink(log_path.c_str());
+        }
+        if (rc != 0) {
+            printf("test-metal-mmid-pair-exact: child (GGML_METAL_MMID_PAIR=%d) failed, rc %d\n", arm, rc);
+            return 1;
+        }
+    }
+
+    std::vector<rec> r[2];
+    for (int arm = 0; arm < 2; ++arm) {
+        if (!read_recs(out_path[arm], cases.size(), r[arm])) {
+            printf("test-metal-mmid-pair-exact: cannot read %s\n", out_path[arm].c_str());
+            return 1;
+        }
+        unlink(out_path[arm].c_str());
+    }
+
+    ggml_backend_t cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+
+    int n_run = 0, n_unsup = 0, n_diff = 0, n_bad_ref = 0, n_pairs_all = 0, n_singles_all = 0;
+    bool ctl_ok = false;
+
+    for (size_t i = 0; i < cases.size(); ++i) {
+        const pair_case & c = cases[i];
+        if (!r[0][i].supported || !r[1][i].supported) {
+            n_unsup++;
+            continue;
+        }
+        if (c.control) {
+            // differs from case 0 (same inputs but one src1 value)
+            ctl_ok = r[1][i].v.size() == r[1][0].v.size() && memcmp(r[1][i].v.data(), r[1][0].v.data(), r[1][0].v.size()*sizeof(float)) != 0;
+            continue;
+        }
+        n_run++;
+
+        // the entries the map kernel builds for these ids
+        const std::vector<int32_t> iv = make_ids(c);
+        std::vector<int32_t> list(ggml_metal_mmid_pair_list_len(c.n_used*c.T));
+        const int32_t n_ent = ggml_metal_mmid_pair_build(iv.data(), c.n_used, (int32_t) c.n_used, (int32_t) c.T, list.data());
+        int n_pairs = 0;
+        for (int32_t e = 0; e < n_ent; ++e) {
+            n_pairs += list[1 + 3*e + 2] >= 0;
+        }
+        n_pairs_all   += n_pairs;
+        n_singles_all += n_ent - n_pairs;
+
+        size_t nd = 0;
+        if (r[0][i].v.size() != r[1][i].v.size()) {
+            nd = r[0][i].v.size() + 1;
+        } else {
+            for (size_t j = 0; j < r[0][i].v.size(); ++j) {
+                nd += memcmp(&r[0][i].v[j], &r[1][i].v[j], sizeof(float)) != 0;
+            }
+        }
+
+        double nmse = 0.0;
+        if (cpu != nullptr) {
+            bool sup = false;
+            std::vector<float> ref = run_case(cpu, c, &sup);
+            if (sup && ref.size() == r[0][i].v.size()) {
+                double num = 0.0, den = 0.0;
+                for (size_t j = 0; j < ref.size(); ++j) {
+                    num += (r[0][i].v[j] - ref[j])*(double) (r[0][i].v[j] - ref[j]);
+                    den += ref[j]*(double) ref[j];
+                }
+                nmse = den > 0 ? num/den : num;
+                n_bad_ref += !(nmse < 5e-4);
+            }
+        }
+
+        printf("  %-5s K %4lld M %3lld n_as %3lld used %2lld T %2lld%s%s: entries %3d (pairs %3d, singles %3d), nmse vs CPU %.2e, differ %zu\n",
+            ggml_type_name(c.type), (long long) c.K, (long long) c.M, (long long) c.n_as, (long long) c.n_used, (long long) c.T,
+            c.bcast ? " bcast" : "", c.dup ? " dup" : "", n_ent, n_pairs, n_ent - n_pairs, nmse, nd);
+
+        n_diff += nd != 0;
+    }
+
+    if (cpu != nullptr) {
+        ggml_backend_free(cpu);
+    }
+
+    if (n_run == 0) {
+        printf("test-metal-mmid-pair-exact: SKIP (MTL0 does not support MUL_MAT_ID: %d of %zu cases not supported)\n", n_unsup, cases.size());
+        return 0;
+    }
+
+    // the paired path must have run in the on arm (one line per op) and never in the off arm
+    const bool engaged = n_log[1] >= n_run && n_log[0] == 0;
+
+    printf("test-metal-mmid-pair-exact: %d cases, %d differ, %d not supported, entries %d paired + %d single, CPU sanity bad %d, control %s, "
+        "paired-path ops %d (off arm %d)%s\n",
+        n_run, n_diff, n_unsup, n_pairs_all, n_singles_all, n_bad_ref, ctl_ok ? "ok" : "FAIL", n_log[1], n_log[0], engaged ? "" : " NOT ENGAGED");
+
+    return n_diff == 0 && n_bad_ref == 0 && ctl_ok && engaged ? 0 : 1;
+}
diff --git a/tests/test-metal-mmid-pair-model.cpp b/tests/test-metal-mmid-pair-model.cpp
new file mode 100644
index 00000000000..8568c8b84c9
--- /dev/null
+++ b/tests/test-metal-mmid-pair-model.cpp
@@ -0,0 +1,116 @@
+// the list of paired routes of the Metal mat-vec MUL_MAT_ID (ggml-metal-mmid-pair.h, the reference of kernel_mul_mv_id_pair_map)
+// against an independent sequential pairing, on random ids of verify windows (1 to 10 experts used, 2 to 16 tokens, 4 to 512
+// experts, few-expert pools so routes collide, repeated experts within a token). Checks: the list equals the sequential one entry
+// for entry, every route is covered exactly once, the routes of an entry share its expert, a pair's routes are in increasing order,
+// the count is at most the number of routes (the grid bound of the paired kernel), and a second build gives the same list.
+// CPU only: no device needed.
+
+#include "../ggml/src/ggml-metal/ggml-metal-mmid-pair.h"
+
+#include <cstdint>
+#include <cstdio>
+#include <map>
+#include <random>
+#include <vector>
+
+// pair the routes of each expert in route order, the entries ordered by their first route
+static std::vector<int32_t> sequential(const std::vector<int32_t> & ids, int32_t n_used, int32_t n_tokens, int64_t stride) {
+    const int32_t n = n_used*n_tokens;
+    std::map<int32_t, std::vector<int32_t>> by_expert;
+    for (int32_t p = 0; p < n; ++p) {
+        by_expert[ids[(p/n_used)*stride + p%n_used]].push_back(p);
+    }
+    std::map<int32_t, std::pair<int32_t, int32_t>> entries; // first route -> (expert, second route)
+    for (const auto & [e, rs] : by_expert) {
+        for (size_t i = 0; i < rs.size(); i += 2) {
+            entries[rs[i]] = { e, i + 1 < rs.size() ? rs[i + 1] : -1 };
+        }
+    }
+    std::vector<int32_t> out(ggml_metal_mmid_pair_list_len(n), 0);
+    out[0] = (int32_t) entries.size();
+    int32_t k = 0;
+    for (const auto & [a, eb] : entries) {
+        out[1 + 3*k + 0] = eb.first;
+        out[1 + 3*k + 1] = a;
+        out[1 + 3*k + 2] = eb.second;
+        k++;
+    }
+    return out;
+}
+
+int main() {
+    std::mt19937 rng(42);
+
+    int n_cases = 0, n_bad = 0;
+    long long n_pairs = 0, n_singles = 0;
+
+    for (int it = 0; it < 4000; ++it) {
+        const int32_t n_used   = 1 + (int32_t) (rng() % 10);
+        const int32_t n_tokens = 2 + (int32_t) (rng() % 15);
+        const int32_t n_expert = std::max<int32_t>(n_used, 4 + (int32_t) (rng() % 509));
+        const int32_t pool     = std::min<int32_t>(n_expert, n_used + (int32_t) (rng() % 6));
+        const bool    dup      = rng() % 4 == 0;
+        const int64_t stride   = n_used + (int64_t) (rng() % 3); // row stride of the ids in int32 (padded rows)
+
+        if (n_used*n_tokens > GGML_METAL_MMID_PAIR_MAX_ROUTES) {
+            continue;
+        }
+
+        std::vector<int32_t> experts(pool);
+        for (int32_t j = 0; j < pool; ++j) {
+            experts[j] = (int32_t) (rng() % n_expert);
+        }
+
+        std::vector<int32_t> ids(n_tokens*stride, -7);
+        for (int32_t t = 0; t < n_tokens; ++t) {
+            for (int32_t s = 0; s < n_used; ++s) {
+                ids[t*stride + s] = dup && s > 0 && rng() % 3 == 0 ? ids[t*stride + s - 1] : experts[rng() % pool];
+            }
+        }
+
+        const int32_t n = n_used*n_tokens;
+        std::vector<int32_t> a(ggml_metal_mmid_pair_list_len(n), 0);
+        std::vector<int32_t> b(ggml_metal_mmid_pair_list_len(n), 0);
+        const int32_t na = ggml_metal_mmid_pair_build(ids.data(), stride, n_used, n_tokens, a.data());
+        const int32_t nb = ggml_metal_mmid_pair_build(ids.data(), stride, n_used, n_tokens, b.data());
+
+        bool ok = na == nb && a == b && na == a[0] && na <= n;
+
+        const std::vector<int32_t> ref = sequential(ids, n_used, n_tokens, stride);
+        ok = ok && ref == a;
+
+        std::vector<int> cover(n, 0);
+        for (int32_t e = 0; e < na && ok; ++e) {
+            const int32_t ex = a[1 + 3*e], pa = a[1 + 3*e + 1], pb = a[1 + 3*e + 2];
+            ok = ok && pa >= 0 && pa < n && ids[(pa/n_used)*stride + pa%n_used] == ex;
+            if (ok) {
+                cover[pa]++;
+            }
+            if (pb >= 0) {
+                ok = ok && pb > pa && pb < n && ids[(pb/n_used)*stride + pb%n_used] == ex;
+                if (ok) {
+                    cover[pb]++;
+                }
+                n_pairs++;
+            } else {
+                n_singles++;
+            }
+            ok = ok && (e == 0 || a[1 + 3*(e - 1) + 1] < pa);
+        }
+        for (int32_t p = 0; p < n && ok; ++p) {
+            ok = cover[p] == 1;
+        }
+
+        n_cases++;
+        if (!ok) {
+            n_bad++;
+            if (n_bad <= 5) {
+                printf("  FAIL: used %d tokens %d experts %d pool %d dup %d stride %lld\n", n_used, n_tokens, n_expert, pool, (int) dup, (long long) stride);
+            }
+        }
+    }
+
+    printf("test-metal-mmid-pair-model: %d cases, %d bad, entries %lld paired + %lld single\n", n_cases, n_bad, n_pairs, n_singles);
+
+    return n_bad == 0 && n_cases > 0 ? 0 : 1;
+}
