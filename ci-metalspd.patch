+    const uintptr_t p0   = p & ~(page - 1);
+    const uintptr_t p1   = (p + size + page - 1) & ~(page - 1);
+    *offs = (size_t) (p - p0);
+    return [device newBufferWithBytesNoCopy:(void *) p0
+                                     length:(NSUInteger) (p1 - p0)
+                                    options:MTLResourceStorageModeShared
+                                deallocator:nil];
+}
